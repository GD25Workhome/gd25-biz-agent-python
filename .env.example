# ============================================
# 数据库配置（必填）
# ============================================
DATABASE_URL=postgresql+psycopg://your_username:your_password@localhost:5432/gd25_biz_agent_python?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=gd25_biz_agent_python

# ============================================
# 模型供应商 API Key（至少配置一个，豆包为默认）
# ============================================
DOUBAO_API_KEY=your-doubao-api-key
# OPENAI_API_KEY=your-openai-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ============================================
# LLM 配置 - 火山引擎（VolcEngine）示例
# ============================================
# 使用火山引擎时，OPENAI_API_KEY 可填豆包密钥（兼容 OpenAI 接口格式）
OPENAI_API_KEY=your-doubao-or-openai-api-key
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=deepseek-v3-2-251201
# LLM_MODEL=deepseek-r1-250528
# LLM_MODEL=doubao-seed-1-6-251015
LLM_MODEL=doubao-seed-1-8-251215

LLM_TEMPERATURE=0.7
LLM_TEMPERATURE_DEFAULT=0.7
LLM_TEMPERATURE_INTENT=0.0
LLM_TEMPERATURE_CLARIFY=0.3
LLM_TOP_P_DEFAULT=1.0
# LLM_MAX_TOKENS_DEFAULT=2048
LLM_LOG_ENABLE=true
LLM_LOG_SAMPLE_RATE=1.0
LLM_LOG_MAX_TEXT_LENGTH=1000

# ============================================
# 应用服务
# ============================================
APP_HOST=0.0.0.0
APP_PORT=9001

# ============================================
# Langfuse 可观测性（可选，默认关闭）
# 云端：https://cloud.langfuse.com
# 本地自托管示例：http://localhost:3000
# ============================================
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=http://localhost:3000

# 提示词获取方式：langfuse、local、auto
PROMPT_SOURCE_MODE=local

# ============================================
# SQL 日志（开发调试用，生产环境建议关闭）
# ============================================
DB_SQL_LOG_ENABLED=true
DB_SQL_LOG_LEVEL=DEBUG
DB_SQL_LOG_SLOW_QUERY_THRESHOLD=1.0
DB_SQL_LOG_INCLUDE_PARAMS=true
DB_SQL_LOG_MAX_SQL_LENGTH=2000
