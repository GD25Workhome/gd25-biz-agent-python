# 采集专用环境变量（K8s「环境变量」也可按行粘贴）

RADAR_DB_HOST=127.0.0.1
RADAR_DB_PORT=3306
RADAR_DB_USER=root
RADAR_DB_PASSWORD=please-change-me
RADAR_DB_NAME=unidt_exhibition

# 默认 all：一个命令启动全部 Worker；一般不用改
RADAR_WORKER_MODE=all

# RADAR_TENANT_ID=1
# RADAR_POLL_INTERVAL_SEC=60
RADAR_CNINFO_FETCH_PDF=1
