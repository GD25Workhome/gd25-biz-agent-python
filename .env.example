# 华院规则二评分服务 — 环境变量样例
#
# 复制为 .env 后按实际环境填写；不要把真实密钥提交进 git。
# 容器 / K8s 用 Secret 注入，镜像不 COPY .env。

# ---------------- LLM ----------------
HUAYUAN_API_KEY=
DEEPSEEK_SEARCH_KEY=
# 可选：未配 DEEPSEEK_SEARCH_KEY 时回退
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_TIMEOUT_SECONDS=30

# ---------------- AnySearch（可选检索工具，DB 凭证池引导 key） ----------------
# 多把 key 逗号分隔、按顺序故障转移；非空时忽略下面的单 key。
# 正式凭证优先从 exhibition MySQL 的 radar_anysearch_key 池读取，这里仅作兜底/引导。
ANY_SEARCH_API_KEYS=
ANY_SEARCH_API_KEY=
ANYSEARCH_API_KEY=

# ---------------- exhibition MySQL ----------------
EXHIBITION_MYSQL_HOST=
EXHIBITION_MYSQL_PORT=3306
EXHIBITION_MYSQL_USER=
EXHIBITION_MYSQL_PASSWORD=
EXHIBITION_MYSQL_DB=unidt_exhibition
EXHIBITION_MYSQL_CHARSET=utf8mb4
EXHIBITION_MYSQL_CONNECT_TIMEOUT=10

# ---------------- radar_score event worker ----------------
RADAR_SCORE_WORKER_IN_APP=false
RADAR_SCORE_EVENT_CONCURRENCY=2
RADAR_SCORE_POLL_INTERVAL_SEC=15
RADAR_SCORE_STALE_TIMEOUT_SEC=2400
RADAR_SCORE_SHUTDOWN_WAIT_SEC=30
RADAR_SCORE_MAX_RETRY=3
# 可选：多租户过滤
RADAR_TENANT_ID=

# ---------------- Langfuse（可选） ----------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
