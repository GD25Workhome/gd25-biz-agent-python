# 环境变量样例（复制为 .env 后填真实值；.env 已在 .gitignore 中，切勿提交）
# ⚠️ 本文件内的值一律为占位符，禁止把真实密钥写进来。

# ---------------- 数据库（华院最小部署可不配） ----------------
# ENABLE_DATABASE=false 时启动不连库；新闻 URL 抓取功能不依赖数据库。
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gd25_biz_agent_python
ENABLE_DATABASE=false

# ---------------- 模型供应商 ----------------
DOUBAO_API_KEY=
ANY_SEARCH_API_KEY=
BO_CHA_APIKEY=

# ---------------- Claude Agent SDK（新闻 URL 抓取 / 正文兜底） ----------------
# 与本机 Claude Code（~/.claude、shell 里个人 ANTHROPIC_*）完全分开：
#   1) 本地只认「本文件 / 项目 .env」里写出的键，不回退 shell 个人 key
#   2) SDK 使用 setting_sources=[] + 项目内 CLAUDE_CONFIG_DIR，不加载 ~/.claude
#   3) 容器无 .env 时，仍可由 K8s Secret 注入同名环境变量
# ⚠️ 真实密钥只写进本地 .env 或 Secret，不要提交、不要写进镜像层。
#
# 网关：公司 Anthropic 兼容入口（不是 OpenAI compatible-mode/v1）
ANTHROPIC_BASE_URL=https://ai-api.unidtai.com/openapi/llm/anthropic
# 凭证二选一（推荐 AUTH_TOKEN）；与 HUAYUAN_API_KEY 可以是同一把公司网关 key
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek/deepseek-v4.1-flash
# 可选：CLI 辅助模型；一般留空
# ANTHROPIC_SMALL_FAST_MODEL=
# 可选：覆盖默认隔离目录（默认：项目根/.claude_sdk_runtime）
# CLAUDE_SDK_CONFIG_DIR=

# ---------------- 新闻 URL 抓取 ----------------
# 必须同时满足 NEWS_CRAWL_ENABLED=true 且项目 .env（或 K8s）配了上面任一凭证；
# 否则 /api/v1/huayuan/news-url-crawl 返回 503（见 config.is_news_crawl_enabled）。
# 仅本机 shell 有个人 ANTHROPIC_*、但项目 .env 未写凭证时，视为未开启。
NEWS_CRAWL_ENABLED=false
# Agent 最大轮次
NEWS_CRAWL_MAX_TURNS=50
# 单次抓取墙钟超时（秒）。调用方（exhibition）侧超时必须 ≥ 本值 + 20s 余量。
NEWS_CRAWL_TIMEOUT_SECONDS=600
# 同时运行的 Agent 数上限，超出者排队；单次成本较高，别设太大
NEWS_CRAWL_MAX_CONCURRENCY=2
# 同站抓取最小请求间隔（秒），礼貌爬取
NEWS_CRAWL_REQUEST_INTERVAL=0.4

# ---------------- 可观测性（可选） ----------------
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ================ 雷达新闻知识库写入链路 ================
# 由 scripts/news_content_worker.py 使用；**不挂 FastAPI**，是独立常驻进程。
# 注意：这里的 MySQL 是 exhibition 的库，与上面主库 PG 是两个实例，勿混。

# ---------------- exhibition MySQL（必填） ----------------
# 取值来源：exhibition/yudao-server/src/main/resources/application-local.yaml
#           spring.datasource.dynamic.datasource.master
EXHIBITION_MYSQL_HOST=
EXHIBITION_MYSQL_PORT=3306
EXHIBITION_MYSQL_USER=
EXHIBITION_MYSQL_PASSWORD=
EXHIBITION_MYSQL_DB=

# ---------------- 公司网关 embedding（必填） ----------------
# OpenAI 兼容 /embeddings 端点；模型默认 unidt/embedding-bge-m3，维度 1024
HUAYUAN_API_KEY=
HUAYUAN_API_URL_embeddings=
EMBEDDING_MODEL=unidt/embedding-bge-m3
EMBEDDING_DIM=1024

# ---------------- Milvus（必填） ----------------
# MILVUS_DB_NAME 是 Milvus 的**库名**（exhibition_test），不是 collection 名
MILVUS_URI=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=exhibition_test
MILVUS_COLLECTION=radar_company_news_chunk

# ---------------- worker 调优（可选） ----------------
# L2（已定）：默认在 FastAPI lifespan 内后台线程跑 radar_kb 统一单 loop
# RADAR_KB_WORKER_IN_APP=true
# 若仍要独立进程：设 RADAR_KB_WORKER_IN_APP=false 后执行 python -m radar_kb unified
#
# 统一 loop 休息间隔（秒）：发现后短休、正文后长休、两路皆空时空闲休
# RADAR_KB_POLL_AFTER_DISCOVER_SEC=2
# RADAR_KB_POLL_AFTER_CONTENT_SEC=10
# RADAR_KB_POLL_IDLE_SEC=10
# 兼容旧名：未设 AFTER_CONTENT / IDLE 时回退到本值
# RADAR_KB_POLL_INTERVAL_SEC=10
# 某类任务查表为空后，至少间隔这么久再查该类（避免每轮空查）
# RADAR_KB_EMPTY_BACKOFF_SEC=60
# 正文 Frontier（P1）：批量认领 + 按礼貌键到点轮询
# RADAR_KB_CONTENT_CLAIM_BATCH=200
# 每站/每企业本批最多认领条数（分组轮询层深）
# RADAR_KB_CONTENT_CLAIM_PER_KEY=3
# RADAR_KB_CONTENT_POLITE_KEY=source_url_id
# RADAR_KB_CONTENT_SAME_KEY_GAP_MIN_SEC=5
# RADAR_KB_CONTENT_SAME_KEY_GAP_MAX_SEC=10
# 发现 RUNNING 超时回收（秒），避免僵尸锁堵正文
# RADAR_KB_CRAWL_STALE_TIMEOUT_SEC=1800
#
# 【遗留】旧 news_content 仅正文 worker；L2 开启时会被跳过，勿与 radar_kb 双开
# NEWS_CONTENT_WORKER_IN_APP=false
# 实例标识；留空自动取 gd25-news-<host>-<pid>
# NEWS_CONTENT_WORKER_ID=
# 每轮抢锁条数 / 空轮询间隔（秒）
# NEWS_CONTENT_BATCH_SIZE=5
# NEWS_CONTENT_POLL_INTERVAL_SECONDS=15
# RUNNING 锁超时（秒），超过则重置回 PENDING；须 > 单任务最长耗时（含 Agent 兜底）
# NEWS_CONTENT_LOCK_TIMEOUT_SECONDS=1800
# 同站抓取最小间隔（秒）/ 单请求超时（秒）/ 失败重试次数
# NEWS_CONTENT_SITE_MIN_INTERVAL_SECONDS=2
# NEWS_CONTENT_HTTP_TIMEOUT_SECONDS=25
# NEWS_CONTENT_HTTP_MAX_RETRIES=1
# 正文最少字数（低于此判为规则抓取失败，转 Agent 兜底）
# NEWS_CONTENT_FETCH_MIN_CHARS=120
# 摘要长度
# NEWS_CONTENT_SUMMARY_MAX_LENGTH=200
# V2 全文切分（策略 C）：窗长 / 重叠 / 单篇上限 / embedding 批大小
# NEWS_CONTENT_CHUNK_SIZE=1000
# NEWS_CONTENT_CHUNK_OVERLAP=200
# NEWS_CONTENT_CHUNK_MAX_PER_DOC=50
# NEWS_CONTENT_EMBED_BATCH_SIZE=16
# 召回：chunk 候选放大倍数 / brief.quote 长度 / 是否附第二段
# KNOWLEDGE_SEARCH_CHUNK_TOP_K_FACTOR=8
# KNOWLEDGE_BRIEF_QUOTE_MAX_CHARS=500
# KNOWLEDGE_BRIEF_SECOND_CHUNK_ENABLED=true
# 【已废弃】V1 单向量截断，读入后忽略
# NEWS_CONTENT_EMBED_TEXT_MAX_CHARS=2000
# Agent 兜底开关 + 日配额 + 连续失败熔断阈值（成本纪律，与 news_crawl 对齐）
# NEWS_CONTENT_AGENT_FALLBACK_ENABLED=true
# NEWS_CONTENT_AGENT_DAILY_QUOTA=30
# NEWS_CONTENT_AGENT_MAX_CONSECUTIVE_FAILURES=5
# # 上项语义：仅统计 system 连续失败；内容失败（壳页等）不触发全局熔断
# NEWS_CONTENT_AGENT_MAX_CONTENT_FAILURES_PER_SITE=1
# NEWS_CONTENT_AGENT_TIMEOUT_SECONDS=180
# embedding 补跑：批大小 / 间隔（秒）/ 单文档最大尝试次数（超限转人工介入）
# NEWS_CONTENT_EMBED_BACKFILL_BATCH_SIZE=10
# NEWS_CONTENT_EMBED_BACKFILL_INTERVAL_SECONDS=120
# NEWS_CONTENT_EMBED_MAX_ATTEMPTS=3
