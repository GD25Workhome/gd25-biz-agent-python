# 本地 Docker 依赖服务配置（复制为 deps.env 后按需修改）
# cp docker/deps.env.example docker/deps.env

# ---------- 已有容器（docker start 方式） ----------
REDIS_CONTAINER=redis_no_pwd
POSTGRES_CONTAINER=postgres_db

# PostgreSQL 健康检查用户（与容器 POSTGRES_USER 一致）
POSTGRES_USER=postgres

# ---------- Langfuse compose 目录（含 docker-compose.yml） ----------
LANGFUSE_COMPOSE_DIR=/Users/shuxiaolong/IdeaProjects/giteeshuxl/technologyStack/【1-develop】/400-开发工具/412-docker/langfuse

# ---------- 宿主机端口（用于健康检查与启动完成提示） ----------
REDIS_PORT=6379
POSTGRES_PORT=5432
LANGFUSE_PORT=3000

# 等待服务就绪的最长时间（秒）
STARTUP_TIMEOUT=120

# macOS：deps.sh start 时若 Docker 未运行，是否自动 open -a Docker（true/false）
AUTO_START_DOCKER_DESKTOP=true
DOCKER_DESKTOP_TIMEOUT=180
